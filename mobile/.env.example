# Local dev (Expo Go on same Wi-Fi as your PC)
EXPO_PUBLIC_API_URL=http://192.168.1.100:5000/api
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_android_google_maps_key

# --- EAS build / Expo Update (phones anywhere) ---
# The APK cannot use localhost or LAN IP. Deploy the backend first, then set
# the public URL and Google Maps key in mobile/eas.json (preview + production env) OR:
#
#   cd mobile
# npx eas-cli env:create --name EXPO_PUBLIC_API_URL --value https://fundilinkug.onrender.com/api --environment preview
# npx eas-cli env:create --name EXPO_PUBLIC_GOOGLE_MAPS_API_KEY --value your_android_google_maps_key --environment preview
