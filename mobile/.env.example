# Local dev (Expo Go on same Wi‑Fi as your PC)
EXPO_PUBLIC_API_URL=http://192.168.1.100:5000/api
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Google Sign-In — native in-app picker (like Bolt). Requires a dev build, not Expo Go.
#
# 1. Google Cloud Console → APIs & Services → Credentials
# 2. Create OAuth client: Web application → copy ID to EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID
# 3. Create OAuth client: Android → package com.fundilink.uganda + your app SHA-1 fingerprint
#    Get SHA-1: cd mobile && npx @react-native-google-signin/config-doctor
# 4. Rebuild the app: cd mobile && npx expo run:android
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_web_client_id.apps.googleusercontent.com
# Optional — only if auto-derived iosUrlScheme is not enough for iOS builds:
# EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.xxxxx
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# --- EAS build / Expo Update (phones anywhere) ---
# The APK cannot use localhost or LAN IP. Deploy the backend first, then set
# the public URL in mobile/eas.json (preview + production env) OR:
#
#   cd mobile
# npx eas-cli env:create --name EXPO_PUBLIC_API_URL --value https://fundilinkug.onrender.com/api --environment preview
