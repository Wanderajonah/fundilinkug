{
  "name": "fundilink-mobile",
  "version": "1.0.1",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "start:tunnel": "expo start --tunnel",
    "android": "bash scripts/android-env.sh expo run:android",
    "android:dev": "bash scripts/android-env.sh expo run:android",
    "android:sdk:install": "bash scripts/install-android-sdk.sh",
    "build:android:dev": "bash scripts/eas-build-dev.sh",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "eas:login": "eas-cli login",
    "eas:init": "eas-cli init",
    "build:android": "eas-cli build --platform android --profile preview",
    "build:android:prod": "eas-cli build --platform android --profile production",
    "update:preview": "eas-cli update --branch preview --message \"Preview update\""
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@maplibre/maplibre-react-native": "^11.3.6",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "axios": "^1.7.7",
    "expo": "~54.0.35",
    "expo-asset": "~12.0.13",
    "expo-auth-session": "~7.0.11",
    "expo-build-properties": "~1.0.10",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-location": "~19.0.8",
    "expo-updates": "~29.0.18",
    "expo-video": "~3.0.16",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-web": "^0.21.0",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@react-native-community/cli": "^20.2.0",
    "eas-cli": "^21.0.1",
    "eslint": "^10.5.0"
  }
}
